{
  "name": "pi-prompt-shaper",
  "version": "0.1.0",
  "description": "The Shaper lifts thin typed pi prompts toward a consistent high-quality shape, opt-in and silent by default.",
  "license": "MIT",
  "keywords": ["pi-package"],
  "pi": { "extensions": ["./extensions/shaper.ts"] },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*" },
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "eval": "node --experimental-strip-types --no-warnings evals/lift.ts"
  }
}
